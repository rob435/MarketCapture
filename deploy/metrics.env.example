# /etc/market-capture/metrics.env (root:market-capture, 0640), read by
# market-tape-metrics.service. Each sample is POSTed as InfluxDB line protocol
# with HTTP basic auth: Grafana Cloud's `…/api/v1/push/influx/write` with its
# instance id and an access token, or any endpoint that speaks line protocol.
# Any of the three empty keeps the samples on the host only.
METRICS_PUSH_URL=
METRICS_PUSH_USER=
METRICS_PUSH_TOKEN=
